FROM alpine:3.21

RUN apk add --no-cache util-linux usbutils tini coreutils

COPY scripts/usbip/attach-in-vm.sh /attach.sh
COPY docker/usbip-entrypoint.sh /usbip-entrypoint.sh
COPY docker/usbip-health.sh /usbip-health.sh
RUN chmod +x /attach.sh /usbip-entrypoint.sh /usbip-health.sh

HEALTHCHECK --interval=5s --timeout=4s --start-period=30s --retries=60 \
  CMD ["/usbip-health.sh"]

ENTRYPOINT ["/sbin/tini", "-s", "-g", "--", "/usbip-entrypoint.sh"]
